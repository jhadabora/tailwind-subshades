{
  "name": "tailwind-subshades",
  "version": "0.1.0",
  "description": "A plugin for Tailwind v3 and v4 for generating intermediate color steps for vanilla and custom Tailwind color tokens.",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "plugin",
    "tailwindv3",
    "tailwindv4",
    "tailwind-plugin",
    "subshades",
    "subshade",
    "colors",
    "subcolors",
    "intermediate",
    "tokens"
  ],
  "homepage": "https://github.com/jhadabora/tailwind-subshades#readme",
  "bugs": {
    "url": "https://github.com/jhadabora/tailwind-subshades/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhadabora/tailwind-subshades.git"
  },
  "license": "MIT",
  "author": "jhadabora",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/tailwindcss": "^3.0.11",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "tailwindcss": "^3.0 || ^4.0"
  },
  "engines": {
    "node": ">=12.20.0"
  }
}
