{
  "name": "tailwind-subshades",
  "version": "0.1.0",
  "description": "A plugin for Tailwind v3 and v4 for generating intermediate color steps for vanilla and custom Tailwind color tokens.",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "plugin",
    "tailwindv3",
    "tailwindv4",
    "tailwind-plugin",
    "subshades",
    "subshade",
    "colors",
    "subcolors",
    "intermediate",
    "tokens"
  ],
  "homepage": "https://github.com/jhadabora/tailwind-subshades#readme",
  "bugs": {
    "url": "https://github.com/jhadabora/tailwind-subshades/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhadabora/tailwind-subshades.git"
  },
  "license": "MIT",
  "author": "jhadabora",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsup src/index.js --format esm,cjs --dts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
