{
  "name": "tailwind-subshades",
  "version": "1.0.0",
  "description": "A plugin for Tailwind v3 and v4 for generating intermediate color steps for vanilla and custom Tailwind color tokens.",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "plugin",
    "tailwindv3",
    "tailwindv4",
    "tailwind-plugin",
    "subshades",
    "subshade",
    "colors",
    "subcolors",
    "intermediate",
    "tokens"
  ],
  "homepage": "https://github.com/jhadabora/tailwind-subshades#readme",
  "bugs": {
    "url": "https://github.com/jhadabora/tailwind-subshades/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhadabora/tailwind-subshades.git"
  },
  "license": "MIT",
  "author": "jhadabora",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/v4.cjs",
  "module": "./dist/v4.mjs",
  "types": "./dist/v4.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/v4.d.mts",
        "default": "./dist/v4.mjs"
      },
      "require": {
        "types": "./dist/v4.d.cts",
        "default": "./dist/v4.cjs"
      }
    },
    "./v4": {
      "import": {
        "types": "./dist/v4.d.mts",
        "default": "./dist/v4.mjs"
      },
      "require": {
        "types": "./dist/v4.d.cts",
        "default": "./dist/v4.cjs"
      }
    },
    "./v3": {
      "import": {
        "types": "./dist/v3.d.mts",
        "default": "./dist/v3.mjs"
      },
      "require": {
        "types": "./dist/v3.d.cts",
        "default": "./dist/v3.cjs"
      }
    },
    "./index": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nested": {
      "import": {
        "types": "./dist/nested.d.mts",
        "default": "./dist/nested.mjs"
      },
      "require": {
        "types": "./dist/nested.d.cts",
        "default": "./dist/nested.cjs"
      }
    },
    "./lib": {
      "import": {
        "types": "./dist/lib/index.d.mts",
        "default": "./dist/lib/index.mjs"
      },
      "require": {
        "types": "./dist/lib/index.d.cts",
        "default": "./dist/lib/index.cjs"
      }
    },
    "./lib/util": {
      "import": {
        "types": "./dist/lib/util.d.mts",
        "default": "./dist/lib/util.mjs"
      },
      "require": {
        "types": "./dist/lib/util.d.cts",
        "default": "./dist/lib/util.cjs"
      }
    },
    "./lib/formula": {
      "import": {
        "types": "./dist/lib/formula.d.mts",
        "default": "./dist/lib/formula.mjs"
      },
      "require": {
        "types": "./dist/lib/formula.d.cts",
        "default": "./dist/lib/formula.cjs"
      }
    },
    "./lib/v4": {
      "import": {
        "types": "./dist/lib/v4.d.mts",
        "default": "./dist/lib/v4.mjs"
      },
      "require": {
        "types": "./dist/lib/v4.d.cts",
        "default": "./dist/lib/v4.cjs"
      }
    },
    "./lib/v3": {
      "import": {
        "types": "./dist/lib/v3.d.mts",
        "default": "./dist/lib/v3.mjs"
      },
      "require": {
        "types": "./dist/lib/v3.d.cts",
        "default": "./dist/lib/v3.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^25.6.0",
    "@types/tailwindcss": "^3.0.11",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "tailwindcss30": "npm:tailwindcss@^3.0.0",
    "tailwindcss3x": "npm:tailwindcss@^3.4.19",
    "tailwindcss40": "npm:tailwindcss@^4.0.0",
    "tailwindcss4x": "npm:tailwindcss@^4.2.4",
    "tailwindpostcss40": "npm:@tailwindcss/postcss@^4.0.0",
    "tailwindpostcss4x": "npm:@tailwindcss/postcss@^4.2.4",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "tailwindcss": "^3.0 || ^4.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "optionalDependencies": {
    "culori": "^4.0.2"
  }
}
